{
  "manifest_version": 3,
  "name": "The Magic Conch Shell",
  "version": "1.0.0",
  "description": "Private Gmail open tracker — the conch knows when your emails are read.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://shell-kappa-lilac.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "The Magic Conch Shell"
  }
}
